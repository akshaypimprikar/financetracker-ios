          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "SETTINGS='/Users/akshaypimprikar/Desktop/Claude/FinanceTracker/.claude/settings.json'; jq -r '.tool_input.command // empty' | { read -r cmd; echo \"$cmd\" | grep -qE '^gh pr create' && jq -r '.permissions.allow[]' \"$SETTINGS\" 2>/dev/null | grep -qE '/private/tmp/claude-|/tmp/claude-|\"pid\":[0-9]|\"window_id\":[0-9]' && echo '{\"systemMessage\": \"REMINDER: .claude/settings.json still has session-specific junk (tmp paths, PIDs) \u2014 run the fewer-permission-prompts skill (prune mode) before this PR ships it.\"}' || true; } 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SETTINGS='/Users/akshaypimprikar/Desktop/Claude/FinanceTracker/.claude/settings.json'; jq -r '.permissions.allow[]' \"$SETTINGS\" 2>/dev/null | grep -qE '/private/tmp/claude-|/tmp/claude-|\"pid\":[0-9]|\"window_id\":[0-9]' && echo '{\"systemMessage\": \"REMINDER: .claude/settings.json still has session-specific entries (tmp paths, PIDs) \u2014 run the fewer-permission-prompts skill (prune mode) before your next session.\"}' || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "REVIEW_DIR='/Users/akshaypimprikar/Desktop/Claude/FinanceTracker/docs/pipeline-review'; UNADDRESSED=$(grep -rl 'addressed: false' \"$REVIEW_DIR\"/*.md 2>/dev/null); if [ -n \"$UNADDRESSED\" ]; then COUNT=$(echo \"$UNADDRESSED\" | wc -l | tr -d ' '); LATEST=$(echo \"$UNADDRESSED\" | sort | tail -1 | xargs basename 2>/dev/null); jq -n --arg count \"$COUNT\" --arg file \"$LATEST\" '{\"systemMessage\": \"PIPELINE REVIEW ALERT: \\($count) unaddressed pipeline review report(s) exist in docs/pipeline-review/. Latest: \\($file). Before starting any planned work, ask the user whether they want to address these findings first.\"}'; fi 2>/dev/null || true"
          }
        ]
      }
    ]
