#!/bin/bash
# Enforces gitflow rules before any push.
# Blocks: direct pushes to develop/main, pushes to branches with merged PRs.

BRANCH=$(git rev-parse --abbrev-ref HEAD)
PROTECTED_BRANCHES=("develop" "main")

# Block direct pushes to protected branches
for PROTECTED in "${PROTECTED_BRANCHES[@]}"; do
    if [ "$BRANCH" = "$PROTECTED" ]; then
        echo "ERROR: Direct push to '$BRANCH' is not allowed."
        echo "Create a branch off '$BRANCH' and open a PR instead."
        exit 1
    fi
done

# Block pushes to branches whose PR is already merged
if command -v gh &>/dev/null; then
    MERGED_PR=$(gh pr list --head "$BRANCH" --state merged --json number --jq '.[0].number' 2>/dev/null)
    if [ -n "$MERGED_PR" ]; then
        echo "ERROR: PR #$MERGED_PR for branch '$BRANCH' is already merged."
        echo "Create a new branch: git checkout -b <new-branch-name>"
        exit 1
    fi
fi

exit 0
